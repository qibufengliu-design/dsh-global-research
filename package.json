{
  "name": "@local/dsh-global-research",
  "version": "0.9.10",
  "description": "DeepSeek Harness 的 research 工具：把开放问题做成带引用、可核查的研究简报（零依赖）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qibufengliu-design/dsh-global-research.git"
  },
  "homepage": "https://github.com/qibufengliu-design/dsh-global-research#readme",
  "bugs": {
    "url": "https://github.com/qibufengliu-design/dsh-global-research/issues"
  },
  "author": "liuqibufeng",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "research",
    "web-search",
    "rag",
    "citation",
    "deepseek"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "e2e": "node scripts/e2e-real.mjs",
    "retrieval-check": "node scripts/retrieval-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
