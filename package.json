{
  "name": "@local/dsh-global-research",
  "version": "0.8.1",
  "description": "Orchestrated global research for DeepSeek Harness: decompose, multi-source search, read, cross-verify, synthesize a cited brief.",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "retrieval-check": "node scripts/retrieval-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "research",
    "web-search",
    "synthesis"
  ],
  "license": "MIT"
}
