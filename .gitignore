# 依赖与产物（本项目零依赖，出现 node_modules 只可能是误操作）
node_modules/

# 运行时缓存：lib/cache.js 默认 persistPath 是 .cache/research.json
.cache/
*.tmp
*.log

# 本地配置与密钥（引擎 key 走 DSH 设置页，不要提交到仓库）
*.local.json

# 测试与覆盖率
coverage/
# 本地跑测试时的重定向日志（`node test/x.test.js > test-out.txt`）
test-out.txt

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时调试脚本与草稿（`tmp-*.mjs`、`probe-*.mjs` 之类跑完就删的东西别进仓库）
tmp-*
probe-*.mjs
.tmp/
.tmp-*       # 测试重定向日志（.tmp-testout.txt 之类）
